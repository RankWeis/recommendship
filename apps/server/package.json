{
  "name": "server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --import tsx src/main.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@recommendship/schema": "workspace:*",
    "better-auth": "1.7.10",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3",
    "vitest": "4.0.1"
  }
}
