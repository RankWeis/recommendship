# Local development. Copy to .env (git-ignored) and adjust.
DATABASE_URL=postgresql://recommendship:recommendship@localhost:54322/recommendship
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# The Vite dev server, which proxies /api to this server, so cookies are same-origin.
BETTER_AUTH_URL=http://localhost:5173
POWERSYNC_URL=http://localhost:8080
ADMIN_EMAILS=dev@recommendship.test
AUTO_APPROVE=true
DEV_LOGIN=true
# Production allows 1,000 new accounts a day; tests create a few every run.
MAX_NEW_USERS_PER_DAY=100000
# Local dev account (created on first sign-in): dev@recommendship.test / recommendship-dev
# Optional locally; production signs in with Google only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Movie and TV lookup (TMDB → Settings → API → API Read Access Token). Books work without it.
# TMDB_READ_TOKEN=
